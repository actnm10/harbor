<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/harbor_background"
    android:fitsSystemWindows="true" android:focusableInTouchMode="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical"
        android:paddingStart="28dp" android:paddingEnd="28dp"
        android:paddingTop="48dp" android:paddingBottom="40dp">
        <ImageView
            android:layout_width="76dp" android:layout_height="76dp"
            android:padding="11dp" android:background="@drawable/bg_logo"
            android:src="@drawable/ic_anchor" android:contentDescription="@null"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/app_name"
            android:textColor="@color/harbor_muted" android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/setup_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/setup_title"
            android:textColor="@color/harbor_ink" android:textSize="30sp"
            android:fontFamily="sans-serif-medium" android:lineSpacingExtra="2dp" />
        <TextView android:id="@+id/setup_support"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="@string/setup_support"
            android:textColor="@color/harbor_muted" android:textSize="16sp"
            android:lineSpacingExtra="5dp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="36dp" android:layout_marginBottom="9dp"
            android:text="@string/server_url_label" android:textColor="@color/harbor_ink"
            android:textSize="14sp" android:fontFamily="sans-serif-medium"
            android:labelFor="@id/server_url" />
        <EditText android:id="@+id/server_url"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="15dp" android:paddingBottom="15dp"
            android:background="@drawable/bg_server_input" android:backgroundTint="@null"
            android:hint="@string/server_url_hint" android:inputType="textUri"
            android:singleLine="true" android:imeOptions="actionGo"
            android:textColor="@color/harbor_ink" android:textColorHint="@color/harbor_muted"
            android:textSize="16sp" android:importantForAutofill="no" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/server_url_help"
            android:textColor="@color/harbor_muted" android:textSize="12sp"
            android:lineSpacingExtra="3dp" />
        <TextView android:id="@+id/setup_error"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:padding="14dp"
            android:background="@drawable/bg_error_message" android:textColor="@color/harbor_error"
            android:textSize="14sp" android:lineSpacingExtra="3dp"
            android:visibility="gone" android:accessibilityLiveRegion="assertive" />
        <Button android:id="@+id/connect_button" style="@style/HarborButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="@string/connect" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/setup_footer"
            android:textColor="@color/harbor_muted" android:textSize="12sp"
            android:lineSpacingExtra="3dp" android:gravity="center" />
    </LinearLayout>
</ScrollView>
