<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HarborButton" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="HarborButton.Secondary">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/harbor_ink</item>
    </style>
</resources>
