<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Harbor" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/harbor_accent</item>
        <item name="android:colorControlHighlight">@color/harbor_ripple</item>
        <item name="android:colorControlNormal">@color/harbor_muted</item>
        <item name="android:colorControlActivated">@color/harbor_accent</item>
        <item name="android:windowBackground">@color/harbor_background</item>
        <item name="android:statusBarColor">@color/harbor_surface</item>
        <item name="android:navigationBarColor">@color/harbor_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
