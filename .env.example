# A hostname only; do not include https:// or a trailing slash.
HARBOR_DOMAIN=files.example.com
ACME_EMAIL=you@example.com

# Absolute path INSIDE your Linux guest. Create it with owner UID/GID 1000.
DATA_PATH=/srv/harbor/data

# Root for storage folders created in Administration; can be on another mounted disk.
STORAGE_PATH=/srv/harbor/storage

# 10 GiB per file and 100 GiB total. Leave space for metadata and backups.
MAX_UPLOAD_BYTES=10737418240
MAX_STORAGE_BYTES=107374182400
MAX_CONCURRENT_UPLOADS=4
SESSION_HOURS=12
